DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_DRIVER=neon
BETTER_AUTH_SECRET=replace-with-32-byte-base64
BETTER_AUTH_URL=http://localhost:5173
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/integrations/gmail/callback
GMAIL_MODE=mock

PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=replace-with-paynow-integration-key
PAYNOW_MODE=mock
PAYNOW_RETURN_URL=http://localhost:5173/billing/success
PAYNOW_RESULT_URL=http://localhost:5173/api/webhooks/paynow

WHATSAPP_WEBHOOK_SECRET=replace-with-random-secret
WHATSAPP_FORWARD_URL=

MATCH_TRIGGER_URL=https://hooks.example.com/api/matches/run
MATCH_TRIGGER_SECRET=replace-with-random-secret
