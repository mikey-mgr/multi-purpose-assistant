# Local database backups
data/backups/

# Scratch space: throwaway scripts, logs and generated PDFs that often contain
# real candidate data. Never commit these.
data/tmp/

# Cloud-drive sync temp files (may contain partial uploads of local secrets)
data/.tmp.*/

# Tool state and stray redirect artifacts
.commandcode/
$null

# Local payment sandbox notes / credentials
web/*sandbox*.md

web/*scandbox*.md

.wrangler/
